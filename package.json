{
  "name": "abi-profile",
  "version": "2.0.0",
  "private": true,
  "description": "Abi Thomas GitHub profile — React/Vite/TypeScript design system that exports GitHub-compatible static SVG assets.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "export": "tsx scripts/export.mts",
    "build:readme": "tsx scripts/build-readme.mts",
    "generate": "npm run export && npm run build:readme",
    "validate": "tsx scripts/validate.mts && git diff --check",
    "check": "npm run validate"
  },
  "keywords": [
    "github-profile",
    "readme",
    "react",
    "vite",
    "typescript",
    "motion",
    "svg",
    "developer-portfolio"
  ],
  "license": "MIT",
  "dependencies": {
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@xmldom/xmldom": "^0.9.0",
    "sharp": "^0.34.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true
  }
}
